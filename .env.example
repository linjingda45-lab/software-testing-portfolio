# 环境变量参考清单
# 说明：本文件仅作变量说明，脚本和程序不会自动读取 .env。
# 请在 PowerShell 中使用 $env:变量名="值" 设置，或配置为系统环境变量。

DB_HOST=127.0.0.1
DB_PORT=3307
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
DB_USER=tester
DB_PASSWORD=Test@123456

# 两个项目的数据库名不同，默认值已分别写在代码中，不建议全局覆盖：
# 项目一 / 测试框架：DB_NAME=ecommerce_test
# 项目二：DB_NAME=content_manage

# 本机 MySQL 安装目录与便携实例配置
MYSQL_HOME=C:\Program Files\MySQL\MySQL Server 8.0
MYSQL_INI=%USERPROFILE%\mysql-portable\my.ini

# Allure 命令行目录
ALLURE_HOME=%USERPROFILE%\allure-cli\allure-2.29.0
